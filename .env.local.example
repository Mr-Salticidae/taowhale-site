# 本地开发环境变量模板。
# 复制为 .env.local 并填入自己的值(.env.local 已被 .gitignore,不会入库)。
# backend/run_local.py 启动时会自动读取 .env.local;未配置项会临时随机生成。

# 本地管理员登录密码(仅本机测试用,任意填)
ADMIN_PASSWORD=change-me-locally

# JWT 签名密钥(留空则每次启动随机生成;如需登录态跨重启保留可固定一个随机串)
# 生成示例:python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
